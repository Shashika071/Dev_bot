# =============================================================================
# Deriv Touch Signal Bot — Environment Configuration
# NEVER commit .env to version control.
# =============================================================================

# --- Deriv API ---
# Public market data needs no token.
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# DERIV_APP_ID=
# DERIV_API_TOKEN=

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deriv_bot
POSTGRES_USER=deriv
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://deriv:change_me_in_production@postgres:5432/deriv_bot

# --- Application ---
APP_TIMEZONE=Asia/Colombo
MAX_SIGNALS_PER_DAY=3
SIGNAL_COOLDOWN_SECONDS=540
CONTRACT_DURATION_SECONDS=540
MAX_TICK_AGE_SECONDS=30
MAX_QUOTE_AGE_SECONDS=90
MANUAL_ENTRY_DELAY_SECONDS=5
MIN_LABEL_WINDOW_TICKS=5
LSTM_SEQ_LEN=64

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
SECRET_KEY=dev_secret_change_me_local_only
INTERNAL_API_SECRET=dev_internal_secret_change_me_local_only

# --- Data Storage ---
PARQUET_DATA_DIR=/app/data/parquet
MODEL_DIR=/app/data/models
