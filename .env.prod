# Private-repo deploy env. On VPS, keep real passwords/secrets here.
# Prefer letters/numbers only in POSTGRES_PASSWORD (or URL-encode special chars in DATABASE_URL).

POSTGRES_DB=deriv_bot
POSTGRES_USER=deriv
POSTGRES_PASSWORD=DerivBot2026Pass

# Host MUST be "postgres" (Docker service name). Never use localhost on the VPS.
DATABASE_URL=postgresql+asyncpg://deriv:DerivBot2026Pass@postgres:5432/deriv_bot

APP_TIMEZONE=Asia/Colombo
MAX_SIGNALS_PER_DAY=3
SIGNAL_COOLDOWN_SECONDS=540
MANUAL_MIN_CONFIDENCE=0.95
MANUAL_MIN_MARGIN_OVER_BREAKEVEN=0.03

# Production model hardening
MIN_EV_MARGIN=0.02
MIN_CALIBRATION_SAMPLES=50
REQUIRE_TOUCH_CONFLUENCE=true
CONFLUENCE_MIN_SCORE=5.0
CONFLUENCE_MIN_GAP=1.5
TRAIN_SAMPLING_INTERVAL_SECONDS=540
TRAIN_GAP_SECONDS=600
TRAIN_MIN_CALIBRATION_SAMPLES=20
TRAIN_EDGE_MIN_SELECTED=15
TRAIN_EDGE_MARGIN=0.02
TRAIN_MAX_TICKS=0
AUTO_PAUSE_ENABLED=true
AUTO_PAUSE_MIN_RESOLVED=20
AUTO_PAUSE_CI_MARGIN=0.0

SECRET_KEY=818e606b1486f1a064ec0d3754c319ec10a768eba094c508ee233d8c71dab31d
INTERNAL_API_SECRET=a36111ad9042f2316a390a65320c56bbf603cfcac2a3ebd05675e3a240cec2a8

# HTTPS on :8443 (Fiyola 80/443 untouched)
DERIV_HTTPS_PORT=8443
VITE_API_URL=https://backdev.crexline.com:8443
VITE_WS_URL=wss://backdev.crexline.com:8443
CORS_ORIGINS=https://devbot.crexline.com:8443,https://backdev.crexline.com:8443
CERTBOT_EMAIL=shashikabio@gmail.com

# Optional Cloudflare Origin cert API
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=crexline.com

PARQUET_DATA_DIR=/app/data/parquet
MODEL_DIR=/app/data/models

