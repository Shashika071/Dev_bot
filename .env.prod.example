# Copy to .env.prod on the VPS. Never commit real secrets.

POSTGRES_DB=deriv_bot
POSTGRES_USER=deriv
# Prefer letters/numbers only. If you use @ # : / in the password, URL-encode them in DATABASE_URL.
POSTGRES_PASSWORD=change_me_strong_password

# Host MUST be "postgres" (Docker service name). Never use localhost on the VPS.
DATABASE_URL=postgresql+asyncpg://deriv:change_me_strong_password@postgres:5432/deriv_bot

APP_TIMEZONE=Asia/Colombo
MAX_SIGNALS_PER_DAY=3
SIGNAL_COOLDOWN_SECONDS=540
MANUAL_MIN_CONFIDENCE=0.95
MANUAL_MIN_MARGIN_OVER_BREAKEVEN=0.03
MIN_EV_MARGIN=0.02
MIN_CALIBRATION_SAMPLES=50
REQUIRE_TOUCH_CONFLUENCE=true
CONFLUENCE_MIN_SCORE=5.0
CONFLUENCE_MIN_GAP=1.5
TRAIN_SAMPLING_INTERVAL_SECONDS=540
TRAIN_GAP_SECONDS=600
TRAIN_MIN_CALIBRATION_SAMPLES=50
TRAIN_EDGE_MIN_SELECTED=30
TRAIN_EDGE_MARGIN=0.02
TRAIN_MAX_TICKS=0
AUTO_PAUSE_ENABLED=true
AUTO_PAUSE_MIN_RESOLVED=20
AUTO_PAUSE_CI_MARGIN=0.0
CERTBOT_EMAIL=

SECRET_KEY=generate_a_long_random_secret
INTERNAL_API_SECRET=generate_another_long_random_secret

# --- Option A: own HTTPS on :8443 (recommended — Fiyola 80/443 untouched) ---
# Use with: ./deploy/up-ssl-ports.sh
# Needs ./certs/origin.pem + ./certs/origin.key (Cloudflare Origin Certificate)
DERIV_HTTPS_PORT=8443
VITE_API_URL=https://backdev.crexline.com:8443
VITE_WS_URL=wss://backdev.crexline.com:8443
CORS_ORIGINS=https://devbot.crexline.com:8443,https://backdev.crexline.com:8443

# Cloudflare Origin Certificate (fixes ERR_CERT_AUTHORITY_INVALID)
# Token: SSL and Certificates Edit + Zone Read on crexline.com
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=crexline.com

# --- Option B: plain HTTP custom ports (no SSL) ---
# DERIV_UI_PORT=8080
# DERIV_API_PORT=8001
# VITE_API_URL=http://backdev.crexline.com:8001
# VITE_WS_URL=ws://backdev.crexline.com:8001
# CORS_ORIGINS=http://devbot.crexline.com:8080,http://backdev.crexline.com:8001

PARQUET_DATA_DIR=/app/data/parquet
MODEL_DIR=/app/data/models
