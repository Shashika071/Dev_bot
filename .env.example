# Copy to .env and fill in values. NEVER commit .env.

# --- Deriv API ---
# Public market data needs no token. Leave blank unless you need authenticated calls.
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# DERIV_APP_ID=
# DERIV_API_TOKEN=

# --- Database ---
# Tick history is stored in ./pgdata on your PC (not inside the image).
# Safe restart: docker compose down   then   docker compose up -d --build
# Do NOT delete the ./pgdata folder. Do NOT use: docker compose down -v
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deriv_bot
POSTGRES_USER=deriv
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://deriv:change_me_in_production@postgres:5432/deriv_bot

# --- Application ---
APP_TIMEZONE=Asia/Colombo
MAX_SIGNALS_PER_DAY=3
SIGNAL_COOLDOWN_SECONDS=540
CONTRACT_DURATION_SECONDS=540
MAX_TICK_AGE_SECONDS=30
MAX_QUOTE_AGE_SECONDS=90
MANUAL_ENTRY_DELAY_SECONDS=5
MIN_LABEL_WINDOW_TICKS=5
LSTM_SEQ_LEN=64
# Manual Analyze & Signal — only create a signal when confidence clears both bars
MANUAL_MIN_CONFIDENCE=0.95
MANUAL_MIN_MARGIN_OVER_BREAKEVEN=0.03

# Live EV / confluence / training hardening
MIN_EV_MARGIN=0.02
MIN_CALIBRATION_SAMPLES=50
REQUIRE_TOUCH_CONFLUENCE=true
CONFLUENCE_MIN_SCORE=5.0
CONFLUENCE_MIN_GAP=1.5
TRAIN_SAMPLING_INTERVAL_SECONDS=540
TRAIN_GAP_SECONDS=600
TRAIN_MIN_CALIBRATION_SAMPLES=20
TRAIN_EDGE_MIN_SELECTED=15
TRAIN_EDGE_MARGIN=0.02
# 0 = load all DB ticks for training; set e.g. 200000 to cap RAM
TRAIN_MAX_TICKS=0
AUTO_PAUSE_ENABLED=true
AUTO_PAUSE_MIN_RESOLVED=20
AUTO_PAUSE_CI_MARGIN=0.0

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
SECRET_KEY=generate_a_random_secret_key_here
INTERNAL_API_SECRET=generate_a_random_internal_secret_here

# --- Data ---
PARQUET_DATA_DIR=/app/data/parquet
MODEL_DIR=/app/data/models
