# Copy to .env.prod on the VPS:
#   cp .env.prod.example .env.prod

# HTTPS edge port (Cloudflare-friendly custom HTTPS)
DERIV_HTTPS_PORT=8443

# Built into the SPA at docker build time
VITE_DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public
VITE_DERIV_SYMBOL=R_100
VITE_HISTORY_COUNT=5000
VITE_SOUND_ALERTS=true
# Same-origin proxy to the always-on research collector container
VITE_RESEARCH_API_URL=/research-api
# Same-origin proxy to the always-on C5 Auto worker
VITE_AUTO_API_URL=/auto-api

# Optional seed for VPS Auto worker (still starts OFF unless AUTO_TRADE_ENABLED=true).
# Prefer saving credentials from Trade settings → VPS Auto panel after deploy.
# AUTO_TRADE_APP_ID=
# AUTO_TRADE_TOKEN=
# AUTO_TRADE_ACCOUNT_ID=
# AUTO_TRADE_ENABLED=false
