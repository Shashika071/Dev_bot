# Always-on C5 Auto trade worker (real ONETOUCH — credentials via env / API)
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV AUTO_TRADE_API_HOST=0.0.0.0
ENV AUTO_TRADE_API_PORT=8788
VOLUME ["/app/auto-trade-data"]
EXPOSE 8788
CMD ["npm", "run", "autotrade:worker"]
